rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admins are declared with a custom claim: { admin: true }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // ---------- User profile + private subcollections ----------
    match /users/{uid} {
      // Profile document. Owner can read/write their own profile.
      // Creation is allowed for the signed-in owner only. No public access.
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
                    && request.resource.data.displayName is string
                    && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid) && request.resource.data.uid == uid;
      allow delete: if isAdmin();

      // ---- exams/{examId}: generated exam definitions ----
      match /exams/{examId} {
        allow read, write: if isOwner(uid);
      }

      // ---- attempts/{attemptId}: completed examination attempts ----
      match /attempts/{attemptId} {
        allow read, write: if isOwner(uid);
      }

      // ---- weakAreas/{conceptId}: derived weak concept records ----
      match /weakAreas/{conceptId} {
        allow read, write: if isOwner(uid);
      }

      // ---- studySessions/{sessionId}: revision note sessions ----
      match /studySessions/{sessionId} {
        allow read, write: if isOwner(uid);
      }

      // ---- questions/{questionId}: validated question bank per user ----
      match /questions/{questionId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---------- Global read-only configuration ----------
    // subjects/, examProfiles/, classProfiles/ are public catalogs.
    // Only admins may write them. Never use "allow read, write: if true;".
    match /subjects/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /examProfiles/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /classProfiles/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------- Deny everything else ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
